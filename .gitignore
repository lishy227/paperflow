memory/*.md
memory/*.bib
memory/*.log
memory/paper-abstracts/
memory/output/
memory/tier2_task.json
memory/pipeline_issues.json
memory/monitors/

# Python cache
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db
