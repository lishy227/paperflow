# ============================================================
# paperflow 配置模板 — 复制为 .env 并填入真实值
#
# 🆓 只用免费源（OpenAlex / arXiv）的话，这个文件可以完全不建——
#    免费源是纯 API，不需要任何 key、浏览器、登录态。
#    只有要搜付费库（IEEE/Scopus/ACM/EV）时才需要 SCOPUS_API_KEY。
# ============================================================

# --- Scopus Search API（仅付费模式必需，免费注册：https://dev.elsevier.com）---
SCOPUS_API_KEY=

# --- LLM（可选，Stage 4 的 AI 重排/中文摘要/主题聚类需要）---
# 不配置则自动跳过 AI 增强，只跑确定性评分（paper_ranker）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- CDP 浏览器调试端口（一般不用改）---
CDP_PORT=18800
